APP__ENV=development
APP__NAME=joseph-api
APP__HOST__PORT=5050
# gRPC for joseph-app's server (internal network only; deploy default 9090)
APP__GRPC__PORT=5051
# Proxies allowed to set X-Forwarded-For besides loopback/private ranges (comma-separated IPs or CIDRs)
APP__HTTP__TRUSTED_PROXIES=
# Browser origins allowed to open the live WebSocket (joseph-app's public origin, comma-separated)
APP__WS__ORIGINS=http://localhost:5173
APP__LOG__LEVEL=debug

APP__DB__HOST=localhost
APP__DB__PORT=5432
APP__DB__USER=joseph
APP__DB__PASSWORD=joseph_dev
APP__DB__NAME=joseph_db
APP__DB__SSLMODE=disable
APP__DB__CONTAINER=joseph-db

APP__REDIS__HOST=localhost
APP__REDIS__PORT=6379
APP__REDIS__PASSWORD=
APP__REDIS__DB=0
APP__REDIS__CONTAINER=joseph-redis

APP__HEALTH__PING_TIMEOUT=2s

APP__NETWORK__NAME=joseph-net

# Cloudflare Turnstile (secret, server-side verification)
APP__TURNSTILE__SECRET_KEY=

# Object storage: MinIO AIStor (API :9000, console :9001)
APP__STORAGE__ENDPOINT=localhost:9000
APP__STORAGE__ACCESS_KEY=
APP__STORAGE__SECRET_KEY=
APP__STORAGE__USE_SSL=false
APP__STORAGE__REGION=us-east-1
APP__STORAGE__BUCKET=joseph
APP__STORAGE__CONTAINER=aistor
