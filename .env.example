APP__ENV=development
APP__NAME=lt-edu-api
APP__HOST__PORT=5050
# gRPC for lt-edu-app's server (internal network only; deploy default 9090)
APP__GRPC__PORT=5051
# Proxies allowed to set X-Forwarded-For besides loopback/private ranges (comma-separated IPs or CIDRs)
APP__HTTP__TRUSTED_PROXIES=
# Browser origins allowed to open the live WebSocket (lt-edu-app's public origin, comma-separated)
APP__WS__ORIGINS=http://localhost:5173
# How often each institution's platform URL is probed for the availability log of the DRE report (0: off; 15m in production)
APP__UPTIME__INTERVAL=0
APP__LOG__LEVEL=debug

APP__DB__HOST=localhost
APP__DB__PORT=5442
APP__DB__USER=ltedu
APP__DB__PASSWORD=ltedu_dev
APP__DB__NAME=ltedu_db
APP__DB__SSLMODE=disable
APP__DB__CONTAINER=lt-edu-db

APP__REDIS__HOST=localhost
APP__REDIS__PORT=6389
APP__REDIS__PASSWORD=
APP__REDIS__DB=0
APP__REDIS__CONTAINER=lt-edu-redis

APP__HEALTH__PING_TIMEOUT=2s

APP__NETWORK__NAME=lt-edu-net

# Public URL of lt-edu-app (links in mail)
APP__SITE__URL=http://localhost:5173

# Auth (session token kept by lt-edu-app in an httpOnly cookie)
APP__SESSION__TTL=168h

# Secrets at rest (TOTP seeds): base64 of 32 bytes (openssl rand -base64 32)
APP__SECRETS__KEY=

# Seed superadmin (created on start when missing)
APP__ADMIN__EMAIL=
APP__ADMIN__PASSWORD=

# Google OAuth (sign in with Google). The redirect must be an authorized redirect URI of this client
APP__GOOGLE__OAUTH__CLIENT_ID=
APP__GOOGLE__OAUTH__CLIENT_SECRET=
APP__GOOGLE__OAUTH__REDIRECT_URL=http://localhost:5173/api/auth/google/callback

# SMTP (Gmail app password). Leave the host empty to print codes and links in the log instead
APP__GOOGLE__SMTP__HOST=
APP__GOOGLE__SMTP__PORT=587
APP__GOOGLE__SMTP__USER=
APP__GOOGLE__SMTP__PASSWORD=
APP__GOOGLE__SMTP__FROM=ListerCore Edu <no-reply@example.com>

# Cloudflare Turnstile (secret, server-side verification)
APP__TURNSTILE__SECRET_KEY=

# Object storage: MinIO AIStor (API :9000, console :9001)
APP__STORAGE__ENDPOINT=localhost:9000
APP__STORAGE__ACCESS_KEY=
APP__STORAGE__SECRET_KEY=
APP__STORAGE__USE_SSL=false
APP__STORAGE__REGION=us-east-1
APP__STORAGE__BUCKET=lt-edu
APP__STORAGE__CONTAINER=aistor

# LiveKit (clases en vivo dentro de la plataforma). Local: make livekit/start (dev keys). Empty URL: only Google Meet
APP__LIVEKIT__URL=ws://localhost:7880
APP__LIVEKIT__API_KEY=devkey
APP__LIVEKIT__API_SECRET=secret
