meta {
  name: Forgot password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/password/forgot
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

docs {
  # POST /auth/password/forgot

  Envía por correo el enlace de restablecimiento (sin SMTP configurado, el enlace sale en el log).
  Header opcional `X-Captcha-Token`.

  | Campo | Tipo |
  |---|---|
  | `email` | string |
}
