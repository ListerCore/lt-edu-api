}

docs {
  # GET /announcements/:id/attachments/:attachmentId

  Descarga un archivo del anuncio (inline). Los de anuncios públicos no necesitan sesión y se cachean 5 min;
  los internos exigen una sesión cuyo rol pueda leerlos y nunca se cachean.
}
